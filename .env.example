YOUTUBE_OAUTH_SECRET=
DATABASE_URL=             # 미설정 시 v0 SQLite 폴백 (sqlite:///data/channel_factory.db)
REDIS_URL=
TELEGRAM_BOT_TOKEN=       # 관제 알림 (선택)
REALESTATE_DATA_DIR=       # 부동산 트랙 데이터 (기본: ~/dev/Projects/Daum_Public_Housing/code/lib)
