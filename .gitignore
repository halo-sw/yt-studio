# 비밀
.env
data/tokens/*
!data/tokens/.gitkeep

# 에셋·산출물 (대용량 — 커밋 금지)
data/assets/*
!data/assets/.gitkeep
# 자막 폰트(Pretendard, SIL OFL)는 렌더 필수 자산이라 커밋
!data/assets/fonts/
data/*.db
*.mp3
*.mp4
*.wav

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node (service/web, M2)
node_modules/
.next/

# OS/에디터
.DS_Store
.idea/
.vscode/
